# Settings for the A/V-over-SD chain.  Read by ~/avsd/hud2.sh when the chain starts.
# Apply a change: systemctl --user restart avsd-chain   (drops the stream for a few seconds)
# Plain NAME=value lines only.  A missing line uses the default in hud2.sh.  Ranges and meaning: DEPLOYMENT.md, "Settings".
GAIN=-3
LINKCAP=4.5e6
MAXVID=161
CYC=4.05e6
KEYINT=0
ENCTHREADS=2
DITHER=0
SRCDEAD=3
SRCMEAN=48
FILLPEN=2
# Flat pale colours such as Maps land: cleans the phone stream speckle, keeps the tint. Ranges and meaning: DEPLOYMENT.md
# --nurelax lets a frame spend decode cycles it would otherwise leave unused, for fewer flat fills on transitions. Off: drop both nurelax flags
ENCEXTRA="--tonepal 3 --nurelax 0.5 --nurelaxthr 0.97"
