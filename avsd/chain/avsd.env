# Settings for the A/V-over-SD chain.  Read by ~/avsd/hud2.sh when the chain starts.
# Apply a change: systemctl --user restart avsd-chain   (drops the stream for a few seconds)
# Plain NAME=value lines only.  A missing line uses the default in hud2.sh.  Ranges and meaning: DEPLOYMENT.md, "Settings".
GAIN=-3
LINKCAP=4.5e6
MAXVID=161
CYC=4.05e6
KEYINT=0
ENCTHREADS=2
DITHER=0
SRCDEAD=3
SRCMEAN=48
FILLPEN=2
# Light mode: no tinted patches on pale map colours. Ranges and meaning: DEPLOYMENT.md
ENCEXTRA="--tonelock 2 --srcdeadpale 1"
